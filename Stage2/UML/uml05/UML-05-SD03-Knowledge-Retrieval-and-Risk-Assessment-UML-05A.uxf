    <coordinates>
      <x>45</x>
      <y>1240</y>
      <w>940</w>
      <h>155</h>
    </coordinates>
    <panel_attributes>synchronized(session): capture contextVersion, current Vehicle v,
saved UserPreference p and listingClarifications; clearRisk().
